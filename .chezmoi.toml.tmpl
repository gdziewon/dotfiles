{{- $osid := .chezmoi.osRelease.id -}}
{{/* Might need to add more in the future */}}
{{- if hasKey .chezmoi.osRelease "idLike" -}}
{{-   if contains "arch" .chezmoi.osRelease.idLike -}}
{{-     $osid = "arch" -}}
{{-   else if contains "debian" .chezmoi.osRelease.idLike -}}
{{-     $osid = "debian" -}}
{{-   end -}}
{{- end -}}

{{- $editor := promptStringOnce . "editor" "Editor" "vim" -}}
{{- $browser := promptStringOnce . "browser" "Browser" "firefox" -}}
{{- $fileManager := promptStringOnce . "fileManager" "File Manager" "dolphin" -}}
{{- $terminal := promptStringOnce . "terminal" "Terminal" "kitty" -}}

# Autogenerated, edit template instead
[data]
    editor = {{ $editor | quote }}
    browser = {{ $browser | quote }}
    fileManager = {{ $fileManager | quote }}
    terminal = {{ $terminal | quote }}
    osid = {{ $osid | quote }}
