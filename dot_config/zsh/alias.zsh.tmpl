alias open="xdg-open"

alias cls="clear"

# I love this.
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias .....='cd ../../../..'
alias ......='cd ../../../../..'

alias tarnow='tar -acf '
alias untar='tar -zxvf'

# Get the error messages from journalctl
alias jctl="journalctl -p 3 -xb"

# gst is to long!~
alias gs='git status'

alias sshp='ssh -o PreferredAuthentications=password'
alias scpp='scp -o PreferredAuthentications=password'

# Replace ls with eza
if command -v eza >/dev/null 2>&1; then
    alias ls='eza -al --color=always --group-directories-first --icons=always' # preferred listing
    alias la='eza -a --color=always --group-directories-first --icons=always'  # all files and dirs
    alias ll='eza -l --color=always --group-directories-first --icons=always'  # long format
    alias lt='eza -aT --color=always --group-directories-first --icons=always' # tree listing
    alias tree="ls --tree"
fi

{{ if eq .osid "arch" -}}

# Arch specific
alias rmpkg="sudo pacman -Rsn"
alias cleanch="sudo pacman -Scc"
alias fixpacman="sudo rm /var/lib/pacman/db.lck"
alias upd="sudo pacman -Syu && paru -Syu"

# Cleanup orphaned packages
alias cln="pacman -Qtdq | sudo pacman -Rns -"

# Recent Installed Packages
alias rip="expac --timefmt='%Y-%m-%d %T' '%l\t%n %v' | sort | tail -200 | nl"

{{ else if eq .osid "debian" -}}

# Debian specific
alias fd="fdfind"
alias upd="sudo apt update && sudo apt upgrade"
alias cln="sudo apt autoremove --purge"

{{ else if eq .osid "gentoo" -}}
# Gentoo specific
alias upd="sudo emerge --ask --update --deep --changed-use @world"
alias cln="sudo emerge --depclean"

{{ end -}}

# Specifically for kitty
if [[ $TERM == "xterm-kitty" ]]; then
    alias sshk="kitty +kitten ssh"
    # I dont want to messa round with it
    alias ssht="TERM=xterm-256color ssh"
    alias clear="clear -T xterm-256color"
    alias icat="kitten icat"
fi

# If bat is available
if command -v bat >/dev/null 2>&1; then
    alias cat="bat -pp"
    alias less="bat --paging=always"
    alias -g -- -h='-h 2>&1 | bat --language=help --style=plain'
    alias -g -- --help='--help 2>&1 | bat --language=help --style=plain'
fi
